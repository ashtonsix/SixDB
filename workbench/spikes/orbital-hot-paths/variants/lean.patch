+void FiniteGroup::release_bound(Identity identity) noexcept {
+  assert(valid(identity));
+  const auto coordinate = bindings_[identity.index];
+  assert(coordinate != unbound);
+  const auto grid = identity.index / 16;
+  const unsigned cls = coordinate & 15u, slot = coordinate >> 4u;
+  assert(!(grids_[grid].pending[cls] & (1u << slot)));
+  assert(grids_[grid].occupied[cls] & (1u << slot));
