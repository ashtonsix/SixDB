+void post_chain(Lane& lane, Message& first, Message& last) noexcept {
+  for (auto* message = &first;; message = message->next.load(std::memory_order_relaxed)) {
+    assert(message && message->ops);
+    message->ops->retain(*message);
+    if (message == &last) break;
+  }
+  const auto notify = lane.notify_posted;
+  void* const context = notify ? lane.notify_context : nullptr;
+  last.next.store(nullptr, std::memory_order_relaxed);
+  auto* predecessor = lane.producer.exchange(&last, std::memory_order_acq_rel);
+  predecessor->next.store(&first, std::memory_order_release);
+  if (notify) notify(context);
+}
