@@ -0,0 +1,100 @@
+#pragma once
+#include "trial.h"
+#include <limits>
+#include <sys/resource.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#if defined(__x86_64__)
+#include <cpuid.h>
+#include <immintrin.h>
+#endif
+
+namespace orbital_versioned_performance {
+// Explicit body-only cold start. Borrowed ranges are used while the issuing
+// Scope/transaction is live, and never dereferenced by the timed request loop.
+// Same capability check/barriers as memory-characterisation's cache probe.
+class BodyConditioning {
+  struct Range { const void* address; std::size_t bytes; };
+  std::vector<Range> ranges_;
+  std::uint64_t begin_{},cpu_{},process_cpu_{};
+  static void flush_line(const void* address) {
+#if defined(__x86_64__)
+    _mm_clflush(address);
+#elif defined(__aarch64__)
+    asm volatile("dc civac, %0" :: "r"(address) : "memory");
+#endif
+  }
+  static void finish() {
+#if defined(__x86_64__)
+    _mm_mfence();
+#elif defined(__aarch64__)
+    asm volatile("dsb ish" ::: "memory");
+#endif
+  }
+  static std::size_t capability() {
+#if defined(__x86_64__)
+    unsigned a,b,c,d;
+    if (!__get_cpuid(1,&a,&b,&c,&d) || !(d&(1u<<19))) return 0;
+    const auto line=((b>>8)&255u)*8u;
+#elif defined(__aarch64__)
+    const auto reported=sysconf(_SC_LEVEL1_DCACHE_LINESIZE);
+    if (reported<=0) return 0;
+    const auto line=static_cast<std::size_t>(reported);
+#else
+    return 0;
+#endif
+#if defined(__x86_64__) || defined(__aarch64__)
+    if (!line || (line&(line-1))) return 0;
+    const auto child=fork();
+    if (!child) {
+      rlimit limit{0,0};setrlimit(RLIMIT_CORE,&limit);
+      alignas(256) std::uint64_t value=1;
+      flush_line(&value);finish();_exit(value==1?0:1);
+    }
+    if (child<0) return 0;
+    int status{};
+    if (waitpid(child,&status,0)<0 || !WIFEXITED(status) || WEXITSTATUS(status)) return 0;
+    return line;
+#endif
+  }
+public:
+  std::size_t line_bytes{},body_bytes{},line_operations{};
+  Interval interval;
+  explicit BodyConditioning(bool requested) {
+    if (requested && !(line_bytes=capability())) throw std::runtime_error("body cache maintenance unsupported");
+  }
+  void start() {process_cpu_=process_cpu_ns();cpu_=caller_cpu_ns();begin_=clock_ns();}
+  void add(const void* address,std::size_t bytes) {
+    if (!bytes) return;
+    const auto first=reinterpret_cast<std::uintptr_t>(address);
+    if (!first || bytes>std::numeric_limits<std::uintptr_t>::max()-first ||
+        bytes>std::numeric_limits<std::size_t>::max()-body_bytes)
+      throw std::invalid_argument("invalid body conditioning range");
+    ranges_.push_back({address,bytes});body_bytes+=bytes;
+  }
+  void flush() {
+    if (!line_bytes || !begin_) throw std::logic_error("body conditioning not started");
+    for (const auto& range:ranges_) {
+      const auto first=reinterpret_cast<std::uintptr_t>(range.address);
+      const auto end=first+range.bytes;
+      for (auto line=first&~std::uintptr_t(line_bytes-1);line<end;) {
+        flush_line(reinterpret_cast<const void*>(line));++line_operations;
+        if (end-line<=line_bytes) break;
+        line+=line_bytes;
+      }
+    }
+    finish();interval.wall_ns=clock_ns()-begin_;
+    interval.caller_cpu_ns=caller_cpu_ns()-cpu_;interval.process_cpu_ns=process_cpu_ns()-process_cpu_;
+  }
+  std::size_t range_count() const {return ranges_.size();}
+  static const char* method() {
+#if defined(__x86_64__)
+    return "CLFLUSH+MFENCE";
+#elif defined(__aarch64__)
+    return "DC_CIVAC+DSB_ISH";
+#else
+    return "unsupported";
+#endif
+  }
+};
+} // namespace orbital_versioned_performance
