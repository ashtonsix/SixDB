+void Lmdb::prepare_short_reader() {
+  if (short_active_) throw std::logic_error("short reader already active");
+  if constexpr (reuse_short_reader) {
+    if (short_view_) throw std::logic_error("short reader already prepared");
+    short_view_.emplace(read());++short_counts_.begins;
+    mdb_txn_reset(short_view_->txn_);++short_counts_.resets;
+  }
+}
+Lmdb::ShortLease Lmdb::short_read() {
+  if (short_active_) throw std::logic_error("nested short reader lease");
+  if constexpr (reuse_short_reader) {
+    if (!short_view_) throw std::logic_error("short reader not prepared");
+    lmdb_check(mdb_txn_renew(short_view_->txn_));++short_counts_.renews;
+  } else {short_view_.emplace(read());++short_counts_.begins;}
+  short_active_=true;return ShortLease(this);
+}
+void Lmdb::end_short_read() noexcept {
+  if constexpr (reuse_short_reader) {mdb_txn_reset(short_view_->txn_);++short_counts_.resets;}
+  else {short_view_.reset();++short_counts_.aborts;}
+  short_active_=false;
+}
+void Lmdb::close_short_reader() {
+  if (short_active_) throw std::logic_error("cannot close active short reader lease");
+  if (short_view_) {short_view_.reset();++short_counts_.aborts;}
+}
 Lmdb::Write Lmdb::edit() {
   MDB_txn* txn{}; lmdb_check(mdb_txn_begin(env_,nullptr,0,&txn)); return Write(txn,db_);
 }
