+#include "lmdb.h"
+#include <iostream>
+using namespace orbital_versioned_performance;
+static void require(bool yes) {if (!yes) throw std::runtime_error("reader lease oracle failed");}
+int main(int argc,char**argv) {
+  if (argc!=2) return 2;
+  Lmdb store(argv[1],64*1024*1024);
+  const Address address{{31,7},{23,9}};
+  std::array<std::byte,3> first{std::byte{1},std::byte{2},std::byte{3}},second{std::byte{7},std::byte{8},std::byte{9}};
+  {auto write=store.edit();write.put(19,{.next=23,.value=11,.tag=1});write.put_part(address,first);write.publish();}
+  std::optional<Lmdb::Read> old(store.read());const auto old_version=old->version();
+  store.prepare_short_reader();
+  {
+    auto lease=store.short_read();auto moved=std::move(lease);
+    require(moved.get(19)->value==11 && moved.part(address)->front()==std::byte{1});
+    require(moved.version()==old_version && store.short_statistics().active);
+    bool nested=false,close=false;
+    try {auto forbidden=store.short_read();} catch(const std::logic_error&) {nested=true;}
+    try {store.close_short_reader();} catch(const std::logic_error&) {close=true;}
+    require(nested && close && store.short_statistics().active);
+  }
+  require(!store.short_statistics().active);
+  {auto write=store.edit();write.put(19,{.next=29,.value=41,.tag=5});write.put_part(address,second);write.publish();}
+  {
+    auto lease=store.short_read();
+    require(lease.version()>old_version && lease.get(19)->value==41 && lease.get(19)->next==29);
+    require(lease.part(address)->front()==std::byte{7});
+    require(old->get(19)->value==11 && old->part(address)->front()==std::byte{1});
+  }
+  require(!store.short_statistics().active);
+  {auto write=store.edit();write.put(19,{.next=37,.value=61,.tag=6});write.publish();}
+  {auto lease=store.short_read();require(lease.get(19)->value==61);require(!lease.get(21));}
+  const auto held=store.short_statistics();require(!held.active);
+  if constexpr(Lmdb::reuse_short_reader) require(held.begins==1 && held.renews==3 && held.resets==4 && held.aborts==0 && held.retained);
+  else require(held.begins==3 && !held.renews && !held.resets && held.aborts==3 && !held.retained);
+  old.reset();store.close_short_reader();auto final=store.short_statistics();
+  require(!final.active && !final.retained && final.aborts==(Lmdb::reuse_short_reader?1:3));
+  store.prepare_short_reader();{auto lease=store.short_read();require(lease.get(19)->value==61);}store.close_short_reader();
+  std::cout<<"{\"passed\":true,\"independent_publication_visibility\":true,\"old_body_and_value_preserved\":true,\"moved_lease\":true,\"nested_and_active_close_refusals\":true,\"reset_counts_and_final_abort\":true,\"reprepare\":true}\n";
+}
