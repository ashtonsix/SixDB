+template<class Physical>
+Result<void> ObjectStore<Physical>::promote_alternative(ObjectId id) {
+  if (!core_) return std::unexpected(Error::absent);
+  Pin pin(core_); auto& c = *pin.core;
+  if (c.scopes || c.pending) return std::unexpected(Error::unavailable);
+  const auto entry = c.entries.find(id);
+  const auto h = entry ? c.head(entry) : Handle{};
+  if (!h || !c.primary(h)) return std::unexpected(Error::absent);
+  if (c.entries.pinned(entry)) return std::unexpected(Error::unavailable);
+  auto* next = c.take_alternative(h);
