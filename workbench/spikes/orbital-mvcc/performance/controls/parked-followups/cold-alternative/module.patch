+template<class Physical>
+Result<void> ObjectStore<Physical>::discard_alternative(ObjectId id) {
+  if (!core_) return std::unexpected(Error::absent);
+  Pin pin(core_); auto& c = *pin.core;
+  const auto h = c.locate(c.cut, id);
+  if (!h || !c.primary(h)) return std::unexpected(Error::absent);
+  auto* value = c.take_alternative(h);
