+auto History<Physical>::take_alternative(Ref version) noexcept -> Value* {
+  const auto where = alternatives.find(key(version));
+  if (where == alternatives.end()) return nullptr;
+  auto* value = where->second;
+  alternatives.erase(where);
+  return value; // Transfer the map's owning use; disposal belongs to the caller.
+}
