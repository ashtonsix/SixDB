+
+template<class T> void check(const T& yes, std::source_location at = std::source_location::current()) {
+  if (bool(yes)) return;
+  std::fprintf(stderr, "%s:%u: check failed\n", at.file_name(), at.line()); std::abort();
+}
+struct Memory : std::pmr::memory_resource {
+  std::size_t live{}, peak{}, calls{}, limit = SIZE_MAX;
+  void* do_allocate(std::size_t bytes, std::size_t alignment) override {
+    if (bytes > limit || live > limit - bytes) throw std::bad_alloc();
+    auto* p = std::pmr::new_delete_resource()->allocate(bytes, alignment);
+    live += bytes; peak = std::max(peak, live); ++calls; return p;
+  }
+  void do_deallocate(void* p, std::size_t bytes, std::size_t alignment) override {
+    check(live >= bytes); live -= bytes;
+    std::pmr::new_delete_resource()->deallocate(p, bytes, alignment);
+  }
+  bool do_is_equal(const std::pmr::memory_resource& other) const noexcept override { return this == &other; }
+};
+struct Physical {
+  struct Value {
+    std::pmr::memory_resource* memory; std::size_t refs; std::uint64_t value;
+    void* context; void (*dispose)(void*);
+  };
+  using Selection = Value*;
+  struct Specification { std::uint64_t value; void* context{}; void (*dispose)(void*){}; };
+  struct PartSource {};
+  enum class ExportPolicy {};
+  static orbital::Result<Value*> capture(std::pmr::memory_resource& memory,
+      Specification spec, std::span<const PartSource>) {
+    try { return std::construct_at(static_cast<Value*>(memory.allocate(sizeof(Value), alignof(Value))),
+        Value{&memory, 1, spec.value, spec.context, spec.dispose}); }
+    catch (const std::bad_alloc&) { return std::unexpected(orbital::Error::capacity); }
+  }
+  static void retain(Value* p) { ++p->refs; }
+  static void release(Value* p) {
+    if (--p->refs) return;
+    auto* memory = p->memory; auto context = p->context; auto dispose = p->dispose;
+    std::destroy_at(p); memory->deallocate(p, sizeof(Value), alignof(Value));
+    if (dispose) dispose(context);
+  }
+  static Value* get(Selection p) { return p; }
+  static Selection selection(Value* p) { return p; }
+  static bool accepts(Value*, orbital::ObjectId, std::uint64_t) { return true; }
+  static bool accepts_resource(Value* p, std::pmr::memory_resource& memory) { return p->memory == &memory; }
+  static bool compatible(Value*, Value*) { return true; }
+  struct Footprint { std::size_t requested_bytes, copied_metadata; };
+  static Footprint footprint(Value*) { return {sizeof(Value), 0}; }
+  static orbital::Result<std::uint64_t> export_part(Selection p, std::size_t,
+      orbital::ObjectBinding, ExportPolicy) { return p->value; }
+};
+namespace orbital::object_detail {
+template<> struct Access<Physical> {
+  static auto stats(const ObjectStore<Physical>& store) { return store.statistics(); }
+  static auto core(const ObjectStore<Physical>& store) { return store.core_; }
+};
+}
+using Store = orbital::ObjectStore<Physical>;
+using Access = orbital::object_detail::Access<Physical>;
+constexpr orbital::ObjectId object(std::uint64_t n) { return {73, n + 1}; }
+Store::Owner owner(Store& store, std::uint64_t value, void* context = nullptr, void (*dispose)(void*) = nullptr) {
+  auto result = store.capture({value, context, dispose}, {}); check(result); return std::move(*result);
+}
+void publish(Store& store, std::span<const Store::Change> changes, Memory& memory) {
+  Store::Prepared prepared(store);
+  {
+    Store::Scope basis(store); check(store.prepare(basis, changes, prepared));
+  }
+  auto calls = memory.calls; check(store.install(prepared)); check(memory.calls == calls);
+}
+void update(Store& store, Memory& memory, std::uint64_t id, std::uint64_t value,
+    void* context = nullptr, void (*dispose)(void*) = nullptr) {
+  std::array<Store::Change, 1> changes{{{object(id), owner(store, value, context, dispose)}}};
+  publish(store, changes, memory);
+}
+void erase(Store& store, Memory& memory, std::uint64_t id) {
+  std::array<Store::Change, 1> changes{{{object(id), {}}}}; publish(store, changes, memory);
+}
+void finish(Store& store, std::size_t budget = 1) {
+  unsigned turns = 0;
+  while (Access::stats(store).maintenance_pending) {
+    auto before = Access::stats(store).reclamation_work;
+    auto work = store.drain(budget); check(work && work <= budget);
+    check(Access::stats(store).reclamation_work == before + work); check(++turns < 100000);
+  }
+  check(!store.drain(budget));
+}
+void seed(Store& store, Memory& memory, unsigned count = 64) {
+  std::array<Store::Change, 64> changes;
+  for (unsigned i = 0; i < count; ++i) changes[i] = {object(i), owner(store, 1000 + i)};
+  publish(store, std::span(changes).first(count), memory);
+}
+void replace_all(Store& store, Memory& memory, unsigned count = 64) {
+  std::array<Store::Change, 64> changes;
+  for (unsigned i = 0; i < count; ++i) changes[i] = {object(i), owner(store, 2000 + i)};
+  publish(store, std::span(changes).first(count), memory);
+}
+void breadth() {
+  Memory memory;
+  {
+    Store store(memory); seed(store, memory);
+    std::optional<Store::Scope> original(std::in_place, store);
+    replace_all(store, memory); finish(store);
+    check(Access::stats(store).versions == 128);
+    const auto before = Access::stats(store);
+    for (unsigned i = 0; i < 128; ++i) {
+      update(store, memory, 0, 3000 + i); finish(store, 3);
+      check(original->bind(object(0))->value == 1000);
+      check(original->bind(object(63))->value == 1063);
+    }
+    auto after = Access::stats(store);
+#ifdef CHANGED_QUEUE
+    check(after.debt_objects == 0);
+    check(after.version_visits - before.version_visits == 128 * 3);
+    check(after.census_visits == before.census_visits);
+#ifdef PAGE_CENSUS
+    check(after.census_word_queries == before.census_word_queries);
+#endif
+#endif
+    auto calls = memory.calls;
+    { Store::Scope current(store); }
+    check(memory.calls == calls && !Access::stats(store).maintenance_pending);
+    original.reset(); check(memory.calls == calls); finish(store);
+    check(Access::stats(store).versions == 64);
+    auto closed = Access::stats(store);
+    std::printf("breadth: core=%zu entry=%zu directory=%zu debt_capacity=%zu visits=%zu close_work=%zu",
+        after.core_bytes, after.entry_bytes, after.object_directory_capacity_bytes, after.debt_capacity_bytes,
+        after.version_visits - before.version_visits, closed.reclamation_work - after.reclamation_work);
+#ifdef CHANGED_QUEUE
+    check(closed.census_visits - after.census_visits == 64);
+    std::printf(" census=%zu", closed.census_visits - after.census_visits);
+#ifdef PAGE_CENSUS
+    check(closed.census_word_queries - after.census_word_queries == 2);
+    std::printf(" words=%zu", closed.census_word_queries - after.census_word_queries);
+#endif
+#endif
+    std::puts("");
+  }
+  check(!memory.live);
+}
+void changing_readers_and_head() {
+  Memory memory;
+  {
+    Store store(memory); seed(store, memory);
+    std::optional<Store::Scope> old(std::in_place, store);
+    replace_all(store, memory);
+    std::optional<Store::Scope> middle(std::in_place, store);
+    replace_all(store, memory); finish(store);
+    old.reset();
+    for (unsigned i = 0; i < 7; ++i) check(store.drain(1) <= 1);
+    middle.reset(); // Entries already passed must be revisited with the weaker plan.
+    finish(store); check(Access::stats(store).versions == 64);
+    std::optional<Store::Scope> basis(std::in_place, store);
+    update(store, memory, 0, 77);
+    check(store.drain(1) == 1); check(store.drain(1) == 1);
+    update(store, memory, 0, 88); // Move a partially visited inline tip into history.
+    finish(store); check(basis->bind(object(0))->value == 2000);
+    check(store.borrow().bind(object(0))->value == 88);
+    basis.reset(); finish(store); check(Access::stats(store).versions == 64);
+  }
+  check(!memory.live);
+}
+void accepted_refusal_abort_and_holes() {
+  Memory memory;
+  {
+    Store store(memory); seed(store, memory);
+    std::optional<Store::Scope> old(std::in_place, store);
+    replace_all(store, memory); finish(store);
+    std::array<Store::Change, 1> changes{{{object(0), owner(store, 3000)}}};
+    Store::Prepared prepared(store);
+    { Store::Scope basis(store); check(store.prepare(basis, changes, prepared)); }
+    old.reset(); auto calls = memory.calls; finish(store);
+    check(memory.calls == calls); // Census cannot steal accepted queue reservation.
+    check(store.install(prepared)); check(memory.calls == calls); finish(store);
+    check(store.borrow().bind(object(0))->value == 3000);
+    old.emplace(store); update(store, memory, 0, 4000); finish(store);
+    erase(store, memory, 0); finish(store);
+    Store::Prepared aborted(store);
+    { Store::Scope basis(store); check(store.prepare(basis, changes, aborted)); }
+    old.reset(); finish(store); calls = memory.calls; aborted.abort(); check(memory.calls == calls);
+    finish(store); check(!store.borrow().bind(object(0)));
+    for (unsigned i = 1; i < 48; ++i) erase(store, memory, i);
+    finish(store); old.emplace(store); update(store, memory, 63, 7000); finish(store);
+    const auto before = Access::stats(store); old.reset(); finish(store);
+    check(Access::stats(store).versions == 16);
+#ifdef CHANGED_QUEUE
+#ifdef PAGE_CENSUS
+    check(Access::stats(store).census_visits - before.census_visits == 1);
+    check(Access::stats(store).census_word_queries - before.census_word_queries == 2);
+#else
+    check(Access::stats(store).census_visits - before.census_visits == 64); // Includes free slots.
+#endif
+#endif
+    old.emplace(store); update(store, memory, 63, 8000);
+    // A genuinely larger distinct-cut plan cannot be allocated under the old limit.
+    std::array<std::unique_ptr<Store::Scope>, 8> readers;
+    for (unsigned i = 0; i < readers.size(); ++i) {
+      readers[i] = std::make_unique<Store::Scope>(store); update(store, memory, 63, 8100 + i);
+    }
+    auto versions = Access::stats(store).versions; memory.limit = memory.live;
+    store.drain(1); check(Access::stats(store).versions == versions);
+    check(Access::stats(store).maintenance_refusals > 0);
+    memory.limit = SIZE_MAX; finish(store);
+    for (unsigned i = 0; i < readers.size(); ++i) check(readers[i]->bind(object(63))->value == (i ? 8099 + i : 8000));
+    for (auto& reader : readers) reader.reset(); old.reset(); finish(store);
+  }
+  check(!memory.live);
+}
+struct Callback {
+  Store* store; Memory* memory; unsigned calls{}; bool reset{};
+  static void run(void* context) {
+    auto& self = *static_cast<Callback*>(context); ++self.calls;
+    check(!self.store->drain(10)); // The active drain owns its traversal.
+    if (self.reset) *self.store = Store{};
+    else update(*self.store, *self.memory, 0, 9000);
+  }
+};
+void tiny_queue_reservation_and_cut_builder() {
+  Memory memory;
+  {
+    Store store(memory); seed(store, memory);
+    std::optional<Store::Scope> oldest(std::in_place, store);
+    for (unsigned i = 0; i < 64; ++i) { update(store, memory, i, 2000 + i); finish(store); }
+    std::optional<Store::Scope> middle(std::in_place, store);
+    for (unsigned i = 0; i < 64; ++i) { update(store, memory, i, 3000 + i); finish(store); }
+    check(Access::stats(store).versions == 192);
+#ifdef CHANGED_QUEUE
+    check(Access::stats(store).debt_capacity_bytes == 8);
+#endif
+    std::array<Store::Change, 1> changes{{{object(0), owner(store, 4000)}}};
+    Store::Prepared accepted(store);
+    { Store::Scope basis(store); check(store.prepare(basis, changes, accepted)); }
+    oldest.reset(); const auto calls = memory.calls; finish(store);
+    // Sixty-four retained histories cannot take the single reserved queue slot.
+    check(memory.calls == calls && Access::stats(store).versions == 128);
+    check(store.install(accepted)); check(memory.calls == calls); finish(store);
+    check(middle->bind(object(0))->value == 2000);
+
+    std::optional<Store::Scope> later(std::in_place, store);
+    update(store, memory, 1, 5000); finish(store);
+    update(store, memory, 2, 5001);
+    // Force a new cut plan with two distinct cuts, then close its builder.
+    std::optional<Store::Scope> latest(std::in_place, store);
+    update(store, memory, 3, 5002); check(store.drain(1) == 1);
+    middle.reset(); check(store.drain(1) == 1); later.reset();
+    finish(store); check(latest->bind(object(3))->value == 3003);
+    latest.reset(); finish(store); check(Access::stats(store).versions == 64);
+  }
+  check(!memory.live);
+}
+void callbacks_and_fairness() {
+  Memory memory;
+  {
+    Store store(memory); seed(store, memory);
+    Callback callback{&store, &memory};
+    update(store, memory, 0, 11, &callback, Callback::run); finish(store);
+    std::optional<Store::Scope> old(std::in_place, store);
+    replace_all(store, memory); finish(store); check(!callback.calls);
+    old.reset(); finish(store); // Census disposal publishes onto its own chain.
+    check(callback.calls == 1 && store.borrow().bind(object(0))->value == 9000);
+    check(Access::stats(store).versions == 64);
+
+    // Erasure/reuse behind a census cursor creates no untracked history.
+    old.emplace(store); replace_all(store, memory); finish(store); old.reset();
+    for (unsigned i = 0; i < 8; ++i) check(store.drain(1) <= 1);
+    erase(store, memory, 0); finish(store); update(store, memory, 1000, 77); finish(store);
+    check(!store.borrow().bind(object(0)) && store.borrow().bind(object(1000))->value == 77);
+
+    old.emplace(store); replace_all(store, memory); finish(store); old.reset();
+    const auto before = Access::stats(store);
+    for (unsigned i = 0; i < 512; ++i) {
+      update(store, memory, 0, 10000 + i); check(store.drain(8) <= 8);
+    }
+#ifdef CHANGED_QUEUE
+#ifdef PAGE_CENSUS
+    check(Access::stats(store).census_visits - before.census_visits >= 63);
+    check(Access::stats(store).census_word_queries - before.census_word_queries == 3);
+#else
+    check(Access::stats(store).census_visits - before.census_visits >= 96);
+#endif
+#endif
+    finish(store); check(Access::stats(store).versions == 65);
+
+    Callback reset{&store, &memory, 0, true};
+    update(store, memory, 0, 12, &reset, Callback::run); finish(store);
+    old.emplace(store); update(store, memory, 0, 13); finish(store); old.reset();
+    store.drain(); check(reset.calls == 1 && !store.borrow().bind(object(0)));
+  }
+  check(!memory.live);
+}
+void interleaved_readers() {
+  Memory memory;
+  {
+    Store store(memory);
+    using Values = std::array<std::uint64_t, 32>;
+    struct Reader { std::optional<Store::Scope> scope; Values values{}; };
+    Values values{};
+    std::array<Reader, 6> readers;
+    std::uint64_t random = 731;
+    auto next = [&] { random ^= random << 13; random ^= random >> 7; random ^= random << 17; return random; };
+    for (unsigned operation = 1; operation <= 2000; ++operation) {
+      const auto id = next() % values.size();
+      auto& reader = readers[next() % readers.size()];
+      switch (next() % 6) {
+      case 0: case 1: update(store, memory, id, operation); values[id] = operation; break;
+      case 2: erase(store, memory, id); values[id] = 0; break;
+      case 3:
+        if (!reader.scope) { reader.scope.emplace(store); reader.values = values; }
+        break;
+      case 4: {
+        const auto calls = memory.calls; reader.scope.reset(); check(memory.calls == calls); break;
+      }
+      default: { const auto budget = next() % 4; check(store.drain(budget) <= budget); break; }
+      }
+      if (!(operation % 31)) finish(store, 3);
+      for (std::size_t i = 0; i < values.size(); ++i) {
+        auto current = store.borrow().bind(object(i)); check((current ? current->value : 0) == values[i]);
+        for (auto& held : readers) if (held.scope) {
+          auto selected = held.scope->bind(object(i));
+          check((selected ? selected->value : 0) == held.values[i]);
+        }
+      }
+    }
+    for (auto& reader : readers) reader.scope.reset(); finish(store);
+    const auto expected = std::count_if(values.begin(), values.end(), [](auto value) { return value != 0; });
+    check(Access::stats(store).versions == static_cast<std::size_t>(expected));
+  }
+  check(!memory.live);
+}
+void renewal_counters(unsigned age) {
+  Memory memory;
+  {
+    Store store(memory); seed(store, memory);
+    std::optional<Store::Scope> reader(std::in_place, store);
+    const auto before = Access::stats(store);
+    for (unsigned i = 0; i < 128; ++i) {
+      update(store, memory, i % 64, 3000 + i); finish(store);
+      if (!((i + 1) % age)) { reader.reset(); reader.emplace(store); finish(store); }
+    }
+    reader.reset(); finish(store);
+    const auto after = Access::stats(store); check(after.versions == 64);
+    std::printf("renewal: objects=64 changed=1 writes=128 age=%u work=%zu visits=%zu entries=%zu",
+        age, after.reclamation_work - before.reclamation_work,
+        after.version_visits - before.version_visits, after.entry_visits - before.entry_visits);
+#ifdef CHANGED_QUEUE
+    std::printf(" census=%zu", after.census_visits - before.census_visits);
+#ifdef PAGE_CENSUS
+    std::printf(" words=%zu", after.census_word_queries - before.census_word_queries);
+#endif
+#endif
+    std::puts("");
+  }
+  check(!memory.live);
+}
+void cached_mask_reuse_and_growth() {
+  Memory memory;
+  {
+    Store store(memory); seed(store, memory);
+    std::optional<Store::Scope> reader(std::in_place, store);
+    replace_all(store, memory); finish(store);
+    erase(store, memory, 31); reader.reset();
+    // The first census word includes this queued tombstone. Queue service
+    // erases it before that cached bit is consumed.
+    unsigned steps = 0;
+    while (Access::stats(store).objects != 63) { check(store.drain(1) == 1); check(++steps < 1000); }
+    update(store, memory, 1000, 7000); // Reuses the deleted position.
+    update(store, memory, 1001, 8000); // Grows beyond the census's snapshotted bound.
+    update(store, memory, 1001, 8001); // Its new history must be owned by the queue.
+    finish(store);
+    check(!store.borrow().bind(object(31)));
+    check(store.borrow().bind(object(1000))->value == 7000);
+    check(store.borrow().bind(object(1001))->value == 8001);
+    check(Access::stats(store).versions == 65);
+    reader.emplace(store); update(store, memory, 1000, 7001); finish(store);
+    reader.reset(); finish(store); check(Access::stats(store).versions == 65);
+  }
+  check(!memory.live);
+}
+void last_history_callback_tombstone() {
+  Memory memory;
+  {
+    Store store(memory); seed(store, memory);
+    Callback callback{&store, &memory};
+    update(store, memory, 31, 11, &callback, Callback::run); finish(store);
+    std::optional<Store::Scope> reader(std::in_place, store);
+    erase(store, memory, 31); finish(store); check(!callback.calls);
+    reader.reset(); finish(store);
+    // The last old owner publishes on another Object. Restart must finish the
+    // now-empty tombstone even though its live page mask is already clear.
+    check(callback.calls == 1 && store.borrow().bind(object(0))->value == 9000);
+    check(Access::stats(store).objects == 63 && Access::stats(store).versions == 63);
+  }
+  check(!memory.live);
+}
+int main() {
+  breadth(); changing_readers_and_head(); accepted_refusal_abort_and_holes(); callbacks_and_fairness();
+  tiny_queue_reservation_and_cut_builder(); interleaved_readers();
+  renewal_counters(1); renewal_counters(64);
+  cached_mask_reuse_and_growth();
+  last_history_callback_tombstone();
+  std::puts("changed queue checks passed");
+}
