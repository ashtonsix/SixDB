+void empty_history_boundaries() {
+  Memory memory;
+  {
+    Store store(memory); seed(store, memory);
+    std::optional<Store::Scope> old(std::in_place, store);
+    update(store, memory, 1000, 70); // Advances the cut without an older node.
+    auto before = Access::stats(store); auto calls = memory.calls;
+    old.reset(); finish(store);
+    check(memory.calls == calls && Access::core(store)->nodes.empty());
+    check(Access::stats(store).census_word_queries == before.census_word_queries);
+
+    old.emplace(store); update(store, memory, 0, 71);
+    // Closing before queued work runs lets that work remove the sole old node.
+    before = Access::stats(store); calls = memory.calls;
+    old.reset(); finish(store);
+    check(memory.calls == calls && Access::core(store)->nodes.empty());
+    check(Access::stats(store).census_word_queries == before.census_word_queries);
+    check(Access::stats(store).census_visits == before.census_visits);
+    check(store.borrow().bind(object(0))->value == 71);
+
+    old.emplace(store); update(store, memory, 1001, 72);
+    std::array<Store::Change, 1> changes{{{object(0), owner(store, 73)}}};
+    Store::Prepared accepted(store);
+    { Store::Scope basis(store); check(store.prepare(basis, changes, accepted)); }
+    // Reserved nodes conservatively prevent skipping even with no linked history.
+    check(!Access::core(store)->nodes.empty());
+    before = Access::stats(store); calls = memory.calls;
+    old.reset(); finish(store);
+    check(memory.calls == calls && Access::stats(store).census_visits == before.census_visits);
+    check(Access::stats(store).census_word_queries > before.census_word_queries);
+    accepted.abort(); check(Access::core(store)->nodes.empty() && memory.calls == calls);
+    check(store.borrow().bind(object(0))->value == 71);
+  }
+  check(!memory.live);
+}
+struct EmptyHistoryCallback {
+  Store* store; Memory* memory; unsigned calls{};
+  static void run(void* context) {
+    auto& self = *static_cast<EmptyHistoryCallback*>(context); ++self.calls;
+    check(Access::core(*self.store)->nodes.empty());
+    // A new tombstone requests restart but creates no older node. The cached
+    // census bit, not nodes.live_, still owns the interrupted tombstone below.
+    erase(*self.store, *self.memory, 1000);
+    check(Access::core(*self.store)->nodes.empty());
+  }
+};
+void last_empty_history_callback_tombstone() {
+  Memory memory;
+  {
+    Store store(memory); seed(store, memory);
+    EmptyHistoryCallback callback{&store, &memory};
+    update(store, memory, 31, 11, &callback, EmptyHistoryCallback::run); finish(store);
+    std::optional<Store::Scope> reader(std::in_place, store);
+    erase(store, memory, 31); finish(store); check(!callback.calls);
+    reader.reset(); finish(store);
+    check(callback.calls == 1 && Access::core(store)->nodes.empty());
+    check(!store.borrow().bind(object(31)) && !store.borrow().bind(object(1000)));
+    check(Access::stats(store).objects == 63 && Access::stats(store).versions == 63);
+  }
+  check(!memory.live);
+}
