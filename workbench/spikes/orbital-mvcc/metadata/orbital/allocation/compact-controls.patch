+// Separate owner/foreign planes retain full timestamps without the padding in
+// an array of optional<Temperature>. Zero temperature means no advice.
+struct HintPlane {
+  std::array<std::chrono::steady_clock::time_point, group_identities> last_access{};
+  std::array<std::uint8_t, group_identities> temperatures{};
+
+  ReleaseHint load(std::uint16_t identity) const noexcept {
+    ReleaseHint result;
+    result.last_access = last_access[identity];
+    if (temperatures[identity]) result.temperature = static_cast<Temperature>(temperatures[identity] - 1);
+    return result;
+  }
+
+  void merge(std::uint16_t identity, const ReleaseHint& incoming) noexcept {
+    if (incoming.last_access != std::chrono::steady_clock::time_point{} &&
+        incoming.last_access < last_access[identity]) return;
+    if (incoming.temperature) temperatures[identity] = static_cast<std::uint8_t>(*incoming.temperature) + 1;
+    if (incoming.last_access != std::chrono::steady_clock::time_point{}) last_access[identity] = incoming.last_access;
+  }
+
+  void clear(std::uint16_t identity) noexcept {
+    last_access[identity] = {};
+    temperatures[identity] = 0;
+  }
+};
+
+static_assert(sizeof(std::chrono::steady_clock::time_point) == 8);
+static_assert(sizeof(HintPlane) == 9 * group_identities);
