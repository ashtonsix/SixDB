+#if SIXDB_TRIM_COMPARE
+namespace {
+void compare_trim_job(Pool& pool, const Group& group, bool retry = false) noexcept {
+  auto& work = pool.internal->trim_comparison;
+  ++work.jobs;
+  if (group.retiring) {
+    ++work.retire_jobs;
+    const auto pages = group.retire_mapped / group.geometry->native_page();
+    work.pages += pages;
+    work.retire_pages += pages;
+    return;
+  }
+  work.retry_jobs += retry;
+  work.ranges += group.trimming.size();
+  work.max_ranges = std::max(work.max_ranges, std::uint64_t(group.trimming.size()));
+  std::uint64_t pages = 0;
+  for (auto span : group.trimming) pages += span.count;
+  work.pages += pages;
+  if (!retry) {
+    work.new_ranges += group.trimming.size();
+    work.new_pages += pages;
+  }
+}
+}
+#endif
