+#include "shape_private.h"
+#include "internal.h"
+
+namespace compact_shape::detail {
+const std::byte* allocation_origin(const orbital::allocation::Storage* owner) noexcept {
+  if (!owner) return nullptr;
+  // Caller owns a live Hold. Its identity cannot rebind or retire during access.
+  // This control uses the unchanged current Allocation layout, not route patches.
+  const auto* domain = owner->domain;
+  if (!domain->finite) return static_cast<const orbital::allocation::detail::Window*>(domain->context)->address;
+  return static_cast<const orbital::allocation::detail::Group*>(domain->context)->geometry->resolve({owner->identity});
+}
+} // namespace compact_shape::detail
