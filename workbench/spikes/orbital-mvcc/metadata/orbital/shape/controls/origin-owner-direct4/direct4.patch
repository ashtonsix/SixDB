+    auto result = cs::detail::retain_part(selected, index, {{9,8},7}, policy);
+    check(!result && result.error() == orbital::Error::capacity);
+    check(memory.live == before && owner->users.load() == oa::detail::returning - 1);
+    check(owner->identity() == identity);
+    check(take(selected.part(index)).address() == address && address[0] == byte);
+  }
+  owner->users.store(users);
+  for (auto policy : {cs::Interpretation::shared_shape, cs::Interpretation::selected_copy}) {
+    auto* retried = take(cs::detail::retain_part(selected, index, {{9,8},7}, policy));
+    check(cs::view(retried).address() == address && cs::view(retried).address()[0] == byte);
+    cs::release(retried);
+  }
+  check(memory.live == before && owner->users.load() == users && owner->identity() == identity);
