+// A first-sweep snapshot must not preserve every newer publication across
+// many reader rotations. Values recorded at enrollment are an independent
+// coherent-read oracle; all Objects are first discovered after later writes.
+template<class Store> void rotating_batch_horizon() {
+  Memory memory;
+  {
+    Store store(memory);
+    constexpr std::size_t count = 64;
+    std::array<std::uint64_t, count> current{}, saved{};
+    const auto id = [](std::size_t i) { return ObjectId{57, i + 1}; };
+    const auto batch = [&](std::size_t changed, std::uint64_t value) {
+      const auto cut = store.borrow().cut + 1;
+      std::array<Change, count> changes;
+      for (std::size_t i = 0; i < changed; ++i) {
+        current[i] = value + i;
+        changes[i] = {id(i), encode(store, id(i), cut, current[i])};
+      }
+      publish(store, std::span(changes).first(changed));
+    };
+    batch(count, 1000); store.drain(); saved = current;
+    std::optional<typename Store::Scope> reader(std::in_place, store);
+    const auto verify = [&] {
+      for (std::size_t i = 0; i < count; ++i) {
+        check(word(reader->bind(id(i))) == saved[i]);
+        check(word(store.borrow().bind(id(i))) == current[i]);
+      }
+    };
+    for (std::uint64_t n = 1; n <= 65; ++n) {
+      batch(n == 65 ? 3 : count, (n + 1) * 1000);
+      check(store.drain(32) <= 32); verify();
+      if (n % 8 == 0) {
+        reader.reset(); reader.emplace(store); saved = current;
+        check(store.drain(32) <= 32);
+      }
+    }
+    const auto held = store.statistics();
+    std::fprintf(stderr, "rotating batch horizon: work=%zu versions=%zu reclaimed=%zu entries=%zu remaining=%zu plans=%zu sweeps=%zu restarts=%zu\n",
+        held.reclamation_work, held.versions, held.reclaimed_versions, held.entry_visits,
+        held.maintenance_remaining_entries, held.plan_work, held.completed_sweeps, held.maintenance_restarts);
+    check(held.reclamation_work <= (65 + 8) * 32);
+    check(held.reclaimed_versions > 0); // Fails with the original whole-sweep horizon.
+    reader.reset(); finish(store, 17);
+    check(store.statistics().versions == count);
+    for (std::size_t i = 0; i < count; ++i) check(word(store.borrow().bind(id(i))) == current[i]);
+  }
+  check(!memory.live);
+}
