# Optional immutable tracked Calico closure; no sibling checkout dependency.
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL "21.1.8")
  message(FATAL_ERROR "Calico controls require pinned Clang 21.1.8")
endif()
get_filename_component(frame_calico_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
file(READ "${frame_calico_root}/workbench/spikes/frame-phase-2/instruments/calico/source.json" frame_calico_manifest)
string(JSON frame_calico_revision GET "${frame_calico_manifest}" revision)
string(JSON frame_calico_sha GET "${frame_calico_manifest}" archive_sha256)
include_guard(GLOBAL)
if(NOT WORKBENCH_FRAME_CALICO_ARCHIVE)
  set(WORKBENCH_FRAME_CALICO_ARCHIVE "${frame_calico_root}/build/frame-helper/calico/sources/calico-${frame_calico_revision}.tar.gz")
endif()
if(NOT EXISTS "${WORKBENCH_FRAME_CALICO_ARCHIVE}")
  message(FATAL_ERROR "Recover the pinned Calico archive with instruments/calico/run.py --prepare first, or set WORKBENCH_FRAME_CALICO_ARCHIVE")
endif()
file(SHA256 "${WORKBENCH_FRAME_CALICO_ARCHIVE}" frame_calico_actual)
if(NOT frame_calico_actual STREQUAL frame_calico_sha)
  message(FATAL_ERROR "Calico archive hash mismatch")
endif()
set(frame_calico_source "${CMAKE_BINARY_DIR}/_deps/frame-calico-${frame_calico_revision}")
if(NOT EXISTS "${frame_calico_source}/calico")
  file(ARCHIVE_EXTRACT INPUT "${WORKBENCH_FRAME_CALICO_ARCHIVE}" DESTINATION "${frame_calico_source}")
endif()
string(JSON frame_calico_files LENGTH "${frame_calico_manifest}" files_sha256)
math(EXPR frame_calico_last "${frame_calico_files} - 1")
foreach(i RANGE 0 ${frame_calico_last})
  string(JSON name MEMBER "${frame_calico_manifest}" files_sha256 ${i})
  string(JSON expected GET "${frame_calico_manifest}" files_sha256 "${name}")
  file(SHA256 "${frame_calico_source}/calico/${name}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Changed Calico source: ${name}")
  endif()
endforeach()
add_library(workbench_calico_frame INTERFACE)
target_include_directories(workbench_calico_frame SYSTEM INTERFACE
  "${frame_calico_source}/calico/frame/include"
  "${frame_calico_source}/calico/engine/include"
  "${frame_calico_source}/calico/kmath/include")
add_library(workbench::calico_frame ALIAS workbench_calico_frame)
